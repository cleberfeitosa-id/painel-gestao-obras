# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Resend — https://resend.com/api-keys
# Sem esta chave o envio de e-mail e apenas registrado em log (nao quebra a aplicacao).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM="Vasconcelos Engenharia <onboarding@resend.dev>"

# URL publica da aplicacao (usada nos links dos e-mails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Branding por implantacao ──
NEXT_PUBLIC_NOME_EMPRESA=Vasconcelos Engenharia
NEXT_PUBLIC_NOME_APLICACAO=Painel de Gestão de Obras
# URL do logo (HTTPS ou caminho local em /public). Sem definicao = LogoVasconcelos SVG padrao.
# NEXT_PUBLIC_LOGO_URL=/meu-logo.svg
# Cores em hex (#RRGGBB). Validacao automatica; fallback = Vasconcelos.
# NEXT_PUBLIC_COR_PRIMARIA=#F48040
# NEXT_PUBLIC_COR_DESTAQUE=#1d4ed8
# Frase institucional opcional
# NEXT_PUBLIC_FRASE_TAGLINE=
# Favicon personalizado. Sem definicao = /favicon.ico existente.
# NEXT_PUBLIC_FAVICON_URL=/favicon.ico
